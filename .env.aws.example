# Copy to .env.aws on the EC2 host. Do not commit .env.aws.

# Public hostnames used by browser users on the EC2 host.
PUBLIC_APP_URL=https://sentinel-api.<EC2_IP>.sslip.io
NEXT_PUBLIC_API_URL=https://sentinel-api.<EC2_IP>.sslip.io
SPLUNK_DASHBOARD_URL=https://sentinel-gw.<EC2_IP>.sslip.io/en-US/app/sentinel/sentinel_overview
NEXT_PUBLIC_SPLUNK_DASHBOARD_URL=https://sentinel-gw.<EC2_IP>.sslip.io/en-US/app/sentinel/sentinel_overview

# Internal Docker-network URL used to generate Splunk saved-search webhooks.
API_PUBLIC_URL=http://sentinel:3001

# Public HTTPS Sentinel API URL used by agent/admin remediation callbacks.
AGENT_TOOL_EXECUTION_BASE_URL=https://sentinel-api.<EC2_IP>.sslip.io

# Host-run proof scripts use this while Splunk receives the internal webhook URL above.
SENTINEL_API_URL=https://sentinel-api.<EC2_IP>.sslip.io

# Splunk Enterprise behind the protected HTTPS gateway.
SPLUNK_HOST=sentinel-gw.<EC2_IP>.sslip.io
SPLUNK_MGMT_URL=https://sentinel-gw.<EC2_IP>.sslip.io
SPLUNK_HEC_URL=https://sentinel-gw.<EC2_IP>.sslip.io
SPLUNK_USERNAME=admin
SPLUNK_PASSWORD=
SPLUNK_HEC_TOKEN=
SPLUNK_TLS_REJECT_UNAUTHORIZED=true
SPLUNK_CA_CERT=
SPLUNK_GATEWAY_TOKEN=
SPLUNK_GATEWAY_MAX_BODY_BYTES=10485760
SPLUNK_APP=sentinel
SPLUNK_INDEX=sentinel
SPLUNK_READY_TIMEOUT_MS=300000
SPLUNK_READY_RETRY_MS=5000

# Sentinel production runtime.
NODE_ENV=production
SENTINEL_RUNTIME_ENV=production
SENTINEL_MODE=true
AGENT_NAME=Sentinel
SENTINEL_REMEDIATION_BACKEND=admin-endpoint
SENTINEL_REMEDIATION_WAIT_MS=30000
SENTINEL_VERIFY_WAIT_MS=15000
SENTINEL_LOCAL_VERIFY=false
SENTINEL_TEST_CONTROLS=false
JWT_SECRET=
WEBHOOK_SECRET=
AGENT_TOOL_SECRET=
SENTINEL_ADMIN_REMEDIATION_SECRET=
SENTINEL_ADMIN_REMEDIATION_ALLOWED_ORIGINS=https://sentinel-api.<EC2_IP>.sslip.io

# Generation provider. Keep the existing provider you intend to use and set its key.
SENTINEL_GENERATION_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-nano-8b-v1
GOOGLE_CLOUD_PROJECT_ID=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=
