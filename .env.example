# MongoDB / app state
MONGODB_ATLAS_URI=                  # Full MongoDB Atlas connection string including credentials.
MONGODB_DATABASE_NAME=sentinel       # Database used by Sentinel web/API state.

# Generation providers
GOOGLE_CLOUD_PROJECT_ID=             # Required only when generation/remediation uses Google Cloud.
GOOGLE_CLOUD_REGION=us-central1
VERTEX_AI_LOCATION=us-central1
OPERAIQ_AI_PROVIDER=vertex           # Legacy env name: vertex for production, offline only for local verification.
OPERAIQ_GENERATION_PROVIDER=         # Optional: vertex, offline, nvidia, or openai-compatible.
NVIDIA_API_KEY=                      # NVIDIA Build/NIM API key; never commit real value.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-nano-8b-v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=

# Splunk / Sentinel
SPLUNK_HOST=localhost                # Local Splunk Enterprise host for development.
SPLUNK_CLOUD_STACK_HOST=             # Preferred Splunk Cloud stack host, e.g. <stack>.splunkcloud.com.
SPLUNK_MGMT_URL=                     # Optional full management URL; overrides derived host.
SPLUNK_HEC_URL=                      # Optional full HEC URL; overrides derived host.
SPLUNK_MGMT_PORT=8089
SPLUNK_HEC_PORT=8088
SPLUNK_HEC_PROTOCOL=https
SPLUNK_CA_CERT=                      # Escaped PEM CA when Splunk endpoint uses a private CA.
SPLUNK_USERNAME=admin
SPLUNK_PASSWORD=                     # Never commit real value.
SPLUNK_HEC_TOKEN=                    # HEC token for Sentinel events/log ingestion.
SPLUNK_GATEWAY_TOKEN=                # Optional token for protected local Splunk tunnel gateway.
SPLUNK_CF_ACCESS_CLIENT_ID=
SPLUNK_CF_ACCESS_CLIENT_SECRET=
SPLUNK_APP=sentinel
SPLUNK_INDEX=sentinel
SPLUNK_DASHBOARD_URL=http://localhost:8000/en-US/app/sentinel/sentinel_overview

# Sentinel runtime
NODE_ENV=development
OPERAIQ_RUNTIME_ENV=development      # Legacy env name; set production for public Sentinel deployments.
SENTINEL_MODE=true
AGENT_NAME=Sentinel
OPERAIQ_REMEDIATION_BACKEND=admin-endpoint # admin-endpoint for Render/Railway/Fly, cloud-run for GCP jobs.
OPERAIQ_REMEDIATION_WAIT_MS=30000
SENTINEL_VERIFY_WAIT_MS=15000
SENTINEL_TEST_CONTROLS=false         # Enables test-only webhook timing/failure headers outside production.
OPERAIQ_LOCAL_VERIFY=false           # Local-only proof mode. Production startup blocks this.
CLOUD_RUN_REMEDIATION_JOB_PREFIX=sentinel-remediate
LOG_LEVEL=info

# API / auth / URLs
PORT=3001
JWT_SECRET=                          # Required; use a long random secret.
WEBHOOK_SECRET=                      # Shared fallback secret for non-org webhooks/tools.
AGENT_TOOL_SECRET=                   # Bearer secret for remediation/tool calls.
PUBLIC_APP_URL=http://localhost:3000 # User-facing web URL.
API_PUBLIC_URL=http://localhost:3001 # Public API URL used to generate Splunk webhook URLs.
NEXT_PUBLIC_API_URL=http://localhost:3001 # Browser-visible API URL.
AGENT_TOOL_EXECUTION_BASE_URL=http://localhost:3001
CORS_ALLOWED_ORIGINS=                # Optional comma-separated extra browser origins.

# Slack / on-call notification
SLACK_BOT_TOKEN=
SLACK_DEFAULT_INCIDENT_CHANNEL=
SLACK_SIGNING_SECRET=

# Legacy Pub/Sub values kept for old non-Sentinel paths. Sentinel trigger uses Splunk Alert Action webhooks.
PUBSUB_ALERT_TOPIC=sentinel-alerts
PUBSUB_EVENTS_TOPIC=sentinel-agent-events
PUBSUB_ALERT_PUSH_SUBSCRIPTION=sentinel-alerts-agent-push
PUBSUB_EVENTS_SUBSCRIPTION=sentinel-agent-events-sse
PUBSUB_PUSH_ENDPOINT=
PUBSUB_PUSH_SERVICE_ACCOUNT=
PUBSUB_PUSH_AUDIENCE=
PUBSUB_PUSH_AUTH_REQUIRED=false
OPERAIQ_LOCAL_PUBSUB_DIRECT=false

# Service runtime config loaded into Splunk KV Store by seed/proof scripts.
OPERAIQ_PAYMENT_SERVICE_ADMIN_BASE_URL=
OPERAIQ_PAYMENT_SERVICE_CLOUD_RUN_SERVICE_NAME=
OPERAIQ_AUTH_SERVICE_ADMIN_BASE_URL=
OPERAIQ_AUTH_SERVICE_CLOUD_RUN_SERVICE_NAME=
OPERAIQ_NOTIFICATION_SERVICE_ADMIN_BASE_URL=
OPERAIQ_NOTIFICATION_SERVICE_CLOUD_RUN_SERVICE_NAME=
OPERAIQ_REDIS_CACHE_ADMIN_BASE_URL=
OPERAIQ_REDIS_CACHE_CLOUD_RUN_SERVICE_NAME=
OPERAIQ_POSTGRES_MAIN_ADMIN_BASE_URL=
OPERAIQ_POSTGRES_MAIN_CLOUD_RUN_SERVICE_NAME=

# Optional MongoDB MCP command for legacy tooling.
MONGODB_MCP_SERVER_COMMAND=
MDB_MCP_LOG_PATH=/tmp/sentinel-mongodb-mcp
