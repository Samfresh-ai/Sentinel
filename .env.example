# MongoDB
MONGODB_ATLAS_URI=                  # Full MongoDB Atlas connection string including credentials.
MONGODB_DATABASE_NAME=operaiq        # Atlas database used by OperaIQ.

# Google Cloud
GOOGLE_CLOUD_PROJECT_ID=             # Google Cloud project ID for Pub/Sub, Cloud Run, and Vertex AI.
GOOGLE_CLOUD_REGION=us-central1      # Cloud Run and Pub/Sub region where applicable.
VERTEX_AI_LOCATION=us-central1       # Vertex AI location for Gemini and embeddings.
OPERAIQ_AI_PROVIDER=vertex           # vertex for production; offline for local verification without Vertex billing.
AGENT_BUILDER_AGENT_ID=              # Vertex AI Agent Builder agent ID after creation.
PUBSUB_ALERT_TOPIC=operaiq-alerts    # Topic where webhook alerts are published.
PUBSUB_EVENTS_TOPIC=operaiq-agent-events # Topic where agent reasoning events are published.
PUBSUB_ALERT_PUSH_SUBSCRIPTION=operaiq-alerts-agent-push # Push subscription that calls /pubsub/alerts.
PUBSUB_EVENTS_SUBSCRIPTION=operaiq-agent-events-sse # Pull subscription used by the SSE bridge.
PUBSUB_PUSH_ENDPOINT=                # Public HTTPS API endpoint ending in /pubsub/alerts; required by pnpm setup:pubsub.
PUBSUB_PUSH_SERVICE_ACCOUNT=         # Service account email used by Pub/Sub push OIDC tokens.
PUBSUB_PUSH_AUDIENCE=                # Expected Pub/Sub push token audience; defaults to PUBSUB_PUSH_ENDPOINT in setup.
PUBSUB_PUSH_AUTH_REQUIRED=false      # Set true in production after configuring Pub/Sub OIDC push auth.
OPERAIQ_LOCAL_PUBSUB_DIRECT=false    # Set true only for local verify:e2e without a public Pub/Sub push endpoint.

# Slack
SLACK_BOT_TOKEN=                     # Slack Bot User OAuth token with chat:write and interactivity scopes.
SLACK_DEFAULT_INCIDENT_CHANNEL=      # Channel ID for incident updates and approvals.
SLACK_SIGNING_SECRET=                # Slack app signing secret for interactive approval verification.

# API
PORT=3001                            # Express API port.
WEBHOOK_SECRET=                      # Shared secret used to verify incoming webhook requests.
AGENT_TOOL_SECRET=                   # Bearer secret for Agent Builder tool execution; defaults to WEBHOOK_SECRET if unset.
AGENT_TOOL_EXECUTION_BASE_URL=       # Public API base URL Agent Builder uses for tool calls; defaults to PUBLIC_APP_URL.
PUBLIC_APP_URL=http://localhost:3000 # Public URL used in Slack incident links.
OPERAIQ_REMEDIATION_WAIT_MS=30000    # Delay between remediation steps; production default is 30000.
CLOUD_RUN_REMEDIATION_JOB_PREFIX=operaiq-remediate # Prefix for per-action Cloud Run remediation jobs.
LOG_LEVEL=info                       # Structured logger level.
OPERAIQ_LOCAL_VERIFY=false           # Set true only to relax Slack checks during local verification.
MONGODB_MCP_SERVER_COMMAND=          # Optional override for the MongoDB MCP server executable.
MDB_MCP_LOG_PATH=/tmp/operaiq-mongodb-mcp # MongoDB MCP server log path.

# Service runtime config
# Optional values loaded by pnpm seed into service_runtime_configs.
# Set these to real service targets before enabling automatic scale/restart/cache/connection remediation.
OPERAIQ_PAYMENT_SERVICE_ADMIN_BASE_URL=            # Base URL for payment-service admin endpoints.
OPERAIQ_PAYMENT_SERVICE_CLOUD_RUN_SERVICE_NAME=    # Cloud Run service name for payment-service.
OPERAIQ_AUTH_SERVICE_ADMIN_BASE_URL=               # Base URL for auth-service admin endpoints.
OPERAIQ_AUTH_SERVICE_CLOUD_RUN_SERVICE_NAME=       # Cloud Run service name for auth-service.
OPERAIQ_NOTIFICATION_SERVICE_ADMIN_BASE_URL=       # Base URL for notification-service admin endpoints.
OPERAIQ_NOTIFICATION_SERVICE_CLOUD_RUN_SERVICE_NAME= # Cloud Run service name for notification-service.
OPERAIQ_REDIS_CACHE_ADMIN_BASE_URL=                # Base URL for redis-cache admin endpoints.
OPERAIQ_REDIS_CACHE_CLOUD_RUN_SERVICE_NAME=        # Cloud Run service name for redis-cache.
OPERAIQ_POSTGRES_MAIN_ADMIN_BASE_URL=              # Base URL for postgres-main admin endpoints.
OPERAIQ_POSTGRES_MAIN_CLOUD_RUN_SERVICE_NAME=      # Cloud Run service name for postgres-main.

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001 # Browser-visible API base URL.
