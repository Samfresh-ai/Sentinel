# Generation providers
GOOGLE_CLOUD_PROJECT_ID=             # Required only when generation/remediation uses Google Cloud.
GOOGLE_CLOUD_REGION=us-central1
VERTEX_AI_LOCATION=us-central1
SENTINEL_AI_PROVIDER=vertex           # vertex for production, offline only for local verification.
SENTINEL_GENERATION_PROVIDER=         # Optional: vertex, offline, nvidia, or openai-compatible.
NVIDIA_API_KEY=                      # NVIDIA Build/NIM API key; never commit real value.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-nano-8b-v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=

# Splunk / Sentinel
SPLUNK_HOST=localhost                # Local Splunk Enterprise host for development.
SPLUNK_CLOUD_STACK_HOST=             # Preferred Splunk Cloud stack host, e.g. <stack>.splunkcloud.com.
SPLUNK_MGMT_URL=                     # Optional full management URL; overrides derived host.
SPLUNK_HEC_URL=                      # Optional full HEC URL; overrides derived host.
SPLUNK_MGMT_PORT=8089
SPLUNK_HEC_PORT=8088
SPLUNK_HEC_PROTOCOL=https
SPLUNK_TLS_REJECT_UNAUTHORIZED=true # Production must keep this true for non-local Splunk endpoints.
SPLUNK_CA_CERT=                      # Escaped PEM CA when Splunk endpoint uses a private CA; hostname validation still applies.
SPLUNK_USERNAME=admin
SPLUNK_PASSWORD=                     # Never commit real value.
SPLUNK_HEC_TOKEN=                    # HEC token for Sentinel events/log ingestion.
SPLUNK_GATEWAY_TOKEN=                # Required when using the local Splunk tunnel gateway.
SPLUNK_GATEWAY_MAX_BODY_BYTES=10485760
SPLUNK_CF_ACCESS_CLIENT_ID=
SPLUNK_CF_ACCESS_CLIENT_SECRET=
SPLUNK_APP=sentinel
SPLUNK_INDEX=sentinel
SPLUNK_DASHBOARD_URL=http://localhost:8000/en-US/app/sentinel/sentinel_overview

# Sentinel runtime
NODE_ENV=development
SENTINEL_RUNTIME_ENV=development      # Set production for public Sentinel deployments.
SENTINEL_MODE=true
AGENT_NAME=Sentinel
SENTINEL_REMEDIATION_BACKEND=admin-endpoint # admin-endpoint for Render/Railway/Fly, cloud-run for GCP jobs.
SENTINEL_REMEDIATION_WAIT_MS=30000
SENTINEL_VERIFY_WAIT_MS=15000
SENTINEL_TEST_CONTROLS=false         # Enables test-only webhook timing/failure headers outside production.
SENTINEL_LOCAL_VERIFY=false           # Local-only proof mode. Production startup blocks this.
CLOUD_RUN_REMEDIATION_JOB_PREFIX=sentinel-remediate
LOG_LEVEL=info

# API / auth / URLs
PORT=3001
JWT_SECRET=                          # Required; use a long random secret.
WEBHOOK_SECRET=                      # Shared fallback secret for non-org webhooks/tools.
AGENT_TOOL_SECRET=                   # Bearer secret for remediation/tool calls.
SENTINEL_ADMIN_REMEDIATION_SECRET=   # Separate secret sent only to approved admin remediation endpoints.
SENTINEL_ADMIN_REMEDIATION_ALLOWED_ORIGINS= # Optional comma-separated HTTPS admin endpoint origins.
PUBLIC_APP_URL=http://localhost:3000 # User-facing web URL.
API_PUBLIC_URL=http://localhost:3001 # Public API URL used to generate Splunk webhook URLs.
NEXT_PUBLIC_API_URL=http://localhost:3001 # Browser-visible API URL.
AGENT_TOOL_EXECUTION_BASE_URL=http://localhost:3001
CORS_ALLOWED_ORIGINS=                # Optional comma-separated extra browser origins.

# Slack / on-call notification
SLACK_BOT_TOKEN=
SLACK_DEFAULT_INCIDENT_CHANNEL=
SLACK_SIGNING_SECRET=

# Service runtime config loaded into Splunk KV Store by seed/proof scripts.
SENTINEL_PAYMENT_SERVICE_ADMIN_BASE_URL=
SENTINEL_PAYMENT_SERVICE_CLOUD_RUN_SERVICE_NAME=
SENTINEL_AUTH_SERVICE_ADMIN_BASE_URL=
SENTINEL_AUTH_SERVICE_CLOUD_RUN_SERVICE_NAME=
SENTINEL_NOTIFICATION_SERVICE_ADMIN_BASE_URL=
SENTINEL_NOTIFICATION_SERVICE_CLOUD_RUN_SERVICE_NAME=
SENTINEL_REDIS_CACHE_ADMIN_BASE_URL=
SENTINEL_REDIS_CACHE_CLOUD_RUN_SERVICE_NAME=
SENTINEL_POSTGRES_MAIN_ADMIN_BASE_URL=
SENTINEL_POSTGRES_MAIN_CLOUD_RUN_SERVICE_NAME=
